# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN DOUYIN TRANSLATOR
# ==========================================

# 1. GitHub Repository để tự động tạo Issue báo cáo (Định dạng: owner/repo-name)
# Ví dụ: trong6so1/video hoặc username/my-douyin-repo
GITHUB_REPO=

# 2. GitHub Personal Access Token (PAT) có quyền 'repo' / 'issues'
# Xem hướng dẫn lấy token trong file README.md
GITHUB_TOKEN=

# 3. Giọng đọc tiếng Việt mặc định (Edge-TTS)
# Các lựa chọn phổ biến: vi-VN-HoaiMyNeural (Nữ), vi-VN-NamMinhNeural (Nam)
TARGET_VOICE=vi-VN-HoaiMyNeural

# 4. Cổng chạy Backend API Server
PORT=8000
